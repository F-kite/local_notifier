{
  "name": "local-notifier-client",
  "version": "1.0.0",
  "description": "Desktop notification client",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "vite build && electron .",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder --win",
    "pack": "vite build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.local-notifier.client",
    "productName": "Алярм",
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "assets/**/*"
    ]
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.1.0",
    "electron-builder": "^26.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}
